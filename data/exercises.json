{"version":1,"frame":[288,216],"patterns":{"sq":{"zh":"膝主導蹲","group":"legs","cue":"腳掌踩穩，膝蓋跟著腳尖方向；下蹲時軀幹保持挺直，站起時腳跟與前腳掌一起發力。"},"lg":{"zh":"單腳蹲／弓箭步","group":"legs","cue":"前腳踩穩、膝蓋不內夾；軀幹微前傾但背部保持中立；左右腳次數一致。"},"hg":{"zh":"髖鉸鏈／腿後側","group":"legs","cue":"動作從髖部往後推開始，背保持平直；重量貼近身體，感覺後大腿拉緊，而不是下背用力。"},"gl":{"zh":"臀部","group":"legs","cue":"頂端夾緊臀部、肋骨收住，避免用下背過度後仰；腳跟出力。"},"ph":{"zh":"水平推（胸）","group":"push","cue":"肩胛先向後下收緊；手肘與軀幹約 45–60 度，不要外開成 90 度；下放要控制。"},"pv":{"zh":"垂直推（肩）","group":"push","cue":"核心與臀部收緊，避免下背過度後仰；手臂推到頭頂正上方。"},"lv":{"zh":"垂直拉（背闊肌）","group":"pull","cue":"先沉肩再拉，想著把手肘往下、往口袋方向帶；不要甩身體借力。"},"lh":{"zh":"水平拉（划船）","group":"pull","cue":"背保持平直，把手肘往後拉並夾緊肩胛；頂端停 1 秒，放回時完全控制。"},"rd":{"zh":"肩後側／上背","group":"pull","cue":"用輕重量，感覺肩後側與上背在出力；避免聳肩。"},"ld":{"zh":"肩側","group":"push","cue":"手肘微彎，抬到肩膀高度即可；不要聳肩、不要甩。"},"tr":{"zh":"三頭肌","group":"push","cue":"上臂固定不晃動；伸直到底但不要鎖死手肘。"},"bi":{"zh":"二頭肌","group":"pull","cue":"上臂貼緊身體不前後擺動；放下時慢一點。"},"ca":{"zh":"小腿","group":"legs","cue":"腳跟盡量抬高並在頂端停 1 秒；放下時充分伸展。"},"co":{"zh":"核心","group":"core","cue":"不要憋氣；腹部收緊、下背不要過度離地或塌陷，動作品質比次數重要。"},"st":{"zh":"伸展／活動度","group":"mobility","cue":"伸展到微緊即可，不要痛；正常呼吸，不彈震。"}},"exercises":[{"id":"squat","zh":"槓鈴背蹲","en":"Squat","pat":"sq","eq":["barbell"],"lvl":2,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"weight_reps","main":"股四頭肌","sec":["臀","核心"],"cues":["槓放在上背肌肉上，不壓頸椎","蹲到大腿約與地面平行，或做到你能維持背部平直的深度"],"img":"img1/squat.webp","next":null},{"id":"leg-press","zh":"腿推機","en":"Leg Press","pat":"sq","eq":["machine"],"lvl":1,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"weight_reps","main":"股四頭肌","sec":["臀","腿後側"],"cues":["背與臀部貼緊椅背","膝蓋跟腳尖同方向，頂端不要鎖死膝蓋"],"img":"img1/leg-press.webp","next":null},{"id":"goblet-squat","zh":"高腳杯深蹲","en":"Goblet Squat","pat":"sq","eq":["db"],"lvl":1,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"weight_reps","main":"股四頭肌","sec":["臀","核心"],"cues":["雙手抱住啞鈴貼胸","下蹲時手肘落在膝蓋內側"],"img":"img1/goblet-squat.webp","next":null},{"id":"smith-machine-squat","zh":"史密斯機深蹲","en":"Smith Machine Squat","pat":"sq","eq":["machine"],"lvl":1,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"weight_reps","main":"股四頭肌","sec":["臀","核心"],"cues":["腳可略往前站","下蹲時軀幹保持挺直"],"img":"img1/smith-machine-squat.webp","next":null},{"id":"bodyweight-squat","zh":"徒手深蹲","en":"Bodyweight Squat","pat":"sq","eq":[],"lvl":1,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"bodyweight_reps","main":"股四頭肌","sec":["臀","腿後側","核心"],"cues":["雙腳與肩同寬，腳尖微外開","手往前伸幫助平衡"],"img":"img1/bodyweight-squat.webp","next":"split-squat"},{"id":"dumbbell-sumo-squat","zh":"啞鈴相撲深蹲","en":"Dumbbell Sumo Squat","pat":"sq","eq":["db"],"lvl":1,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"weight_reps","main":"臀","sec":["股四頭肌","內收肌","腿後側"],"cues":["雙腳寬站、腳尖朝外","雙手垂握一顆啞鈴，蹲時膝蓋對準腳尖"],"img":"img1/dumbbell-sumo-squat.webp","next":null},{"id":"banded-squat","zh":"彈力帶深蹲","en":"Banded Squat","pat":"sq","eq":["band"],"lvl":1,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"bodyweight_reps","main":"股四頭肌","sec":["臀","腿後側","核心"],"cues":["彈力帶踩在腳下或套在膝上方","站起時膝蓋不要內夾"],"img":"img1/banded-squat.webp","next":null},{"id":"hack-squat","zh":"哈克深蹲機","en":"Hack Squat","pat":"sq","eq":["machine"],"lvl":2,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"weight_reps","main":"股四頭肌","sec":["臀"],"cues":["背貼緊靠墊","腳掌全程踩穩，不讓腳跟離地"],"img":"img1/hack-squat.webp","next":null},{"id":"leg-extension","zh":"腿伸展機","en":"Leg Extension","pat":"sq","eq":["machine"],"lvl":1,"iso":true,"bwOk":false,"warm":false,"cool":false,"type":"weight_reps","main":"股四頭肌","sec":[],"cues":["膝蓋對準機器軸心","頂端停 1 秒，放下時慢慢控制"],"img":"img1/leg-extension.webp","next":null},{"id":"wall-sit","zh":"靠牆靜蹲","en":"Wall Sit","pat":"sq","eq":[],"lvl":1,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"duration","main":"股四頭肌","sec":["臀","核心"],"cues":["背貼牆，大腿約與地面平行","均勻呼吸，時間到再起身"],"img":"img1/wall-sit.webp","next":"cossack-squat"},{"id":"cossack-squat","zh":"哥薩克深蹲","en":"Cossack Squat","pat":"sq","eq":[],"lvl":2,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"bodyweight_reps","main":"股四頭肌","sec":["臀","腿後側","核心"],"cues":["一側腿蹲下、另一腿伸直","蹲的那隻腳整個腳掌踩穩"],"img":"img1/cossack-squat.webp","next":"assisted-pistol-squat"},{"id":"assisted-pistol-squat","zh":"輔助單腿深蹲","en":"Assisted Pistol Squat","pat":"sq","eq":[],"lvl":3,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"bodyweight_reps","main":"股四頭肌","sec":["臀","腿後側","核心"],"cues":["一手扶穩固物體輔助","用單腳慢慢蹲下，蹲不下去就縮小幅度"],"img":"img1/assisted-pistol-squat.webp","next":null},{"id":"split-squat","zh":"分腿蹲","en":"Split Squat","pat":"lg","eq":["db"],"lvl":1,"iso":false,"bwOk":true,"warm":false,"cool":false,"type":"weight_reps","main":"股四頭肌","sec":["臀","核心"],"cues":["前後腳站開，身體垂直上下","前腳全腳掌踩穩，膝蓋不內夾"],"img":"img1/split-squat.webp","next":null},{"id":"reverse-lunge","zh":"後跨步蹲","en":"Reverse Lunge","pat":"lg","eq":["db"],"lvl":1,"iso":false,"bwOk":true,"warm":false,"cool":false,"type":"weight_reps","main":"股四頭肌","sec":["臀","腿後側"],"cues":["往後跨一步再下蹲","前腳承擔大部分重量"],"img":"img1/reverse-lunge.webp","next":null},{"id":"forward-lunge","zh":"前跨步蹲","en":"Forward Lunge","pat":"lg","eq":[],"lvl":1,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"bodyweight_reps","main":"股四頭肌","sec":["臀","腿後側","核心"],"cues":["跨出後膝蓋朝腳尖方向","起身時前腳蹬地回到站姿"],"img":"img1/forward-lunge.webp","next":"skater-squat"},{"id":"step-up","zh":"登階","en":"Step-Up","pat":"lg","eq":["db"],"lvl":1,"iso":false,"bwOk":true,"warm":false,"cool":false,"type":"weight_reps","main":"股四頭肌","sec":["臀"],"cues":["用穩固的階梯或矮凳","踩上去時用前腳出力，不要靠後腳蹬"],"img":"img1/step-up.webp","next":null},{"id":"walking-lunge","zh":"走步弓箭步","en":"Walking Lunge","pat":"lg","eq":["db"],"lvl":2,"iso":false,"bwOk":true,"warm":false,"cool":false,"type":"weight_reps","main":"股四頭肌","sec":["臀","腿後側"],"cues":["每一步都完整下蹲","保持軀幹挺直"],"img":"img1/walking-lunge.webp","next":null},{"id":"lateral-lunge","zh":"側弓箭步","en":"Lateral Lunge","pat":"lg","eq":[],"lvl":1,"iso":false,"bwOk":false,"warm":false,"cool":false,"type":"bodyweight_reps","main":"